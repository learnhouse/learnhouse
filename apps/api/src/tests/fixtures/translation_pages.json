    {
     "type": "heading",
     "attrs": {
      "level": 2
     },
     "content": [
      {
       "type": "text",
       "text": "When a card is declined"
      }
     ]
    },
    {
     "type": "paragraph",
     "content": [
      {
       "type": "text",
       "text": "Most declines are not fraud. The bank said no for a reason it shares as a decline code, and the customer can usually fix it in a minute.",
       "marks": [
        {
         "type": "textEffect",
