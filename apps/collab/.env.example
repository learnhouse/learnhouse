COLLAB_PORT=4000
LEARNHOUSE_API_URL=http://localhost:1338
# Both secrets must be at least 32 characters. Generate with: openssl rand -hex 32
# LEARNHOUSE_AUTH_JWT_SECRET_KEY must match the API's value.
LEARNHOUSE_AUTH_JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
COLLAB_INTERNAL_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
