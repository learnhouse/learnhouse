{
  "name": "@learnhouse/react",
  "version": "1.4.3",
  "description": "Render LearnHouse activities in any React app, with the same blocks and styles as LearnHouse itself.",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "sync": "node scripts/sync.mjs",
    "sync:check": "node scripts/sync.mjs --check",
    "prepublishOnly": "node scripts/sync.mjs --check && node scripts/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/learnhouse/learnhouse.git",
    "directory": "packages/react"
  },
  "homepage": "https://learnhouse.app",
  "bugs": {
    "url": "https://github.com/learnhouse/learnhouse/issues"
  },
  "keywords": [
    "learnhouse",
    "lms",
    "react",
    "tiptap",
    "education",
    "embed"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
