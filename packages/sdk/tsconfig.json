{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "paths": {
      "@learnhouse-web/media": ["../../apps/web/services/media/media.ts"],
      "@services/config/config": ["./src/media/config-shim.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
